# Android build output
android/build/
android/keystore.jks
android/*.jks
# v2 signature side-car produced next to the APK by apksigner
*.apk.idsig

# APK 建置產物 —— 不進版控。
# 二進位檔放進 repo 會令每次 clone 都變重，而且每次重建都多一份歷史，
# 對「APK 只是載入線上頁面的超薄外殼」這個架構沒有任何好處。
# 需要 APK 請依 README「建置 APK」一節自行建置。
*.apk

# Signing material — NEVER commit these
*.jks
*.keystore

# Assistant scratch / local notes
.workbuddy-ai/
.v12.dex
__pycache__/

# `--teeth` fixture: a copy of the PRE-FIX page used to prove a probe can fail.
# Created on demand (git show HEAD:index.html > __prefix.html) and served by
# tools/check-single-direction.js --teeth. Never commit it — it is by
# definition an outdated copy of index.html and would confuse the repo.
__prefix.html
